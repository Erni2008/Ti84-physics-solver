	call	_io_draw_title
	pop	hl
	ld	hl, (ix - 38)
	ld	hl, (hl)
	ld	de, 26
	push	de
	push	hl
	ld	hl, 1
	push	hl
	call	_io_draw_wrapped_text
	pop	hl
	pop	hl
	pop	hl
	ld	hl, (ix - 31)
	ld	bc, 21
	call	__imulu
	push	hl
	pop	de
	ld	hl, _SYMBOL_ENTRIES
	add	hl, de
	ld	(ix - 38), hl
	ld	a, 2
	ld	l, a
	ld	(ix - 31), hl
	ld	bc, 3
