	push	bc
	pop	hl
	ld	de, 21
	or	a, a
	sbc	hl, de
	jr	z, BB178_6
	ld	(ix - 41), bc
	ld	hl, (ix - 38)
	add	hl, bc
	ld	hl, (hl)
	add	hl, bc
	or	a, a
	sbc	hl, bc
	jr	z, BB178_5
	ld	a, (hl)
	or	a, a
	ld	de, 26
	push	de
	push	hl
	ld	hl, (ix - 31)
	push	hl
	call	nz, _io_draw_wrapped_text
	pop	hl
	pop	hl
	pop	hl
BB178_5:
	ld	iy, (ix - 41)
	ld	de, 3
	add	iy, de
	ld	hl, (ix - 31)
	inc	l
	ld	(ix - 31), hl
	lea	bc, iy
	jr	BB178_2
BB178_6:
	ld	hl, _.str.1.568
	push	hl
	call	_io_draw_footer
	pop	hl
	call	_io_read_menu_key
	ld	l, a
	cp	a, 1
	ld	c, (ix - 35)
	jr	nz, BB178_8
	ld	a, c
	or	a, a
	jr	nz, BB178_13
BB178_8:
	ld	a, l
	cp	a, 2
	ld	iy, _SYMBOL_ENTRIES
	ld	de, 21
	jr	nz, BB178_11
	ld	a, c
	cp	a, 5
	jr	nc, BB178_11
	inc	c
	jp	BB178_1
BB178_11:
	ld	a, l
	cp	a, 4
	jr	z, BB178_14
	ld	a, l
	cp	a, 5
	jp	nz, BB178_1
	jr	BB178_15
BB178_13:
	dec	c
	ld	iy, _SYMBOL_ENTRIES
	ld	de, 21
	jp	BB178_1
BB178_14:
	ld	hl, 1
	jr	BB178_16
BB178_15:
	ld	hl, 2
BB178_16:
	ld	sp, ix
